[Unit]
Description=Paper Compass secondary incremental conference ingestion
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=papercompass
Group=papercompass
WorkingDirectory=/opt/paper-compass
# Legacy fallback when .env is absent; the single env file overrides this.
Environment=PAPER_FIREHOSE_DATA_DIR=/opt/paper-compass/.runtime-demo
EnvironmentFile=-/opt/paper-compass/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/paper-compass/.venv/bin/paper-firehose --config /opt/paper-compass/.runtime-demo/config/config.yaml update --scope conferences
TimeoutStartSec=45min
Nice=15
CPUQuota=100%
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemoryHigh=650M
MemoryMax=900M
NoNewPrivileges=true
PrivateTmp=true
