# Paper Compass: copy to project-root .env; never commit the real .env.
# CLI, Python API and startup scripts load .env automatically.
# Priority: explicit CLI arguments > process environment > .env > code defaults.
# Values are literal: no $VAR, ${VAR}, command substitution or multiline values.
# Relative file paths resolve against the directory containing .env.

# 1. Website and paths (5)
PAPER_FIREHOSE_DATA_DIR=.runtime-demo
# PAPER_COMPASS_HOST=127.0.0.1
# PAPER_COMPASS_PUBLIC_URL=https://papercompass.cn
# PAPER_COMPASS_DOCS_DIR=docs
# PAPER_COMPASS_API_URL=http://127.0.0.1:8765

# 2. GitHub sign-in (2): register /auth/github/callback as the callback.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# 3. Local development account (1).
# Leave unset to preserve start_frontend_dev.sh's local-only automatic login.
# Production defaults to 0. Never use 1 for a public deployment.
# PAPER_COMPASS_DEV_LOGIN=0

# 4. User activity (3). Local frontend development defaults to disabled.
# PAPER_COMPASS_EVENTS_ENABLED=1
# PAPER_COMPASS_EVENTS_RETENTION_DAYS=90
# PAPER_COMPASS_EVENTS_DAILY_LIMIT=100000

# 5. Topic classification and conservative cost limits (14).
# api is explicitly enabled after testing; keywords remains the manual backup.
PAPER_COMPASS_CLASSIFIER=keywords
# PAPER_COMPASS_CLASSIFICATION_API_KEY=
PAPER_COMPASS_CLASSIFICATION_BASE_URL=https://api.deepseek.com
PAPER_COMPASS_CLASSIFICATION_MODEL=deepseek-flash
PAPER_COMPASS_CLASSIFICATION_REASONING_EFFORT=none
PAPER_COMPASS_CLASSIFICATION_TIMEOUT=60
PAPER_COMPASS_CLASSIFICATION_MAX_TOKENS=512
PAPER_COMPASS_CLASSIFICATION_LIMIT=0
# All API attempts share these daily limits (Beijing calendar day).
PAPER_COMPASS_CLASSIFICATION_DAILY_BUDGET_CNY=3
# 0 papers means drain new jobs; -1 request/token limits means no count cap.
# A zero request/token limit blocks all new calls; money protection still applies.
PAPER_COMPASS_CLASSIFICATION_DAILY_REQUEST_LIMIT=-1
PAPER_COMPASS_CLASSIFICATION_DAILY_TOKEN_LIMIT=-1
# DeepSeek Flash off-peak CNY/million-token rates, NOT a live provider bill.
# A per-request time guard blocks weekday peaks, including manual runs.
# Recheck these if the provider/model/pricing changes.
PAPER_COMPASS_CLASSIFICATION_PRICE_INPUT=1
PAPER_COMPASS_CLASSIFICATION_PRICE_CACHED_INPUT=0.02
PAPER_COMPASS_CLASSIFICATION_PRICE_OUTPUT=4

# 6. Optional external sources, PaperQA and email (4).
# OPENALEX_API_KEY=
# OPENAI_API_KEY=
# MAILTO=you@example.com
# SMTP_PASSWORD=

# Meilisearch title search. Configure a loopback service and build-search before serving.
# PAPER_COMPASS_MEILI_URL=http://127.0.0.1:7700
# Optional for a loopback-only Meilisearch instance started without a master key.
# PAPER_COMPASS_MEILI_SEARCH_KEY=
# PAPER_COMPASS_MEILI_WRITE_KEY=
