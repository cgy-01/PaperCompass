# Example only. This file is not loaded automatically.
# Export values in your shell or use systemd EnvironmentFile.
PAPER_FIREHOSE_DATA_DIR=.runtime-demo
# PAPER_COMPASS_DOCS_DIR=/absolute/path/to/paper-compass/docs
# PAPER_COMPASS_API_URL=http://127.0.0.1:8765
# PAPER_COMPASS_HOST=127.0.0.1
# OPENALEX_API_KEY=
# OPENAI_API_KEY=

# GitHub sign-in: register an OAuth app with /auth/github/callback as callback.
# PAPER_COMPASS_PUBLIC_URL=https://papercompass.cn
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Local development only; start_frontend_dev.sh enables this automatically.
# Never enable for a public deployment. Uses users/development.db.
# PAPER_COMPASS_DEV_LOGIN=0
# Activity events are separate from paper snapshots; disable with 0.
# PAPER_COMPASS_EVENTS_ENABLED=1
# PAPER_COMPASS_EVENTS_RETENTION_DAYS=90
# PAPER_COMPASS_EVENTS_DAILY_LIMIT=100000
